# Network: hedera-testnet, hedera-previewnet, hedera-mainnet or local
NETWORK=hedera-testnet

# A funded account with a local key (for example from portal.hedera.com).
# It pays for setup and coordinates the multi-party example.
FUNDING_ACCOUNT_ID=0.0.
FUNDING_PRIVATE_KEY=
# ECDSA_SECP256K1 (portal default) or ED25519
FUNDING_KEY_ALGORITHM=ECDSA_SECP256K1

# AWS KMS: an ECC_SECG_P256K1 or ECC_NIST_EDWARDS25519 key with SIGN_VERIFY usage.
# Credentials come from the usual AWS SDK chain (profile, env, role).
AWS_KMS_KEY_ID=alias/hiero-finance
AWS_REGION=eu-central-1

# Vault transit, see `npm run vault:up`
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=root
VAULT_KEY_NAME=hiero-operations

# Written by `npm run example:setup`
KMS_ACCOUNT_ID=
TREASURY_ACCOUNT_ID=
COMPLIANCE_PRIVATE_KEY=
